# Dominio de producción. Si falta, se omiten canonical, og:url y el sitemap
# (ver docs/06-decisiones.md D3). No poner una URL temporal.
PUBLIC_SITE_URL=

# Formulario de contacto (docs/04-engineering.md §6, src/pages/api/contacto.ts).
# Server-side, sin prefijo PUBLIC_: nunca llegan al bundle del cliente.
# Degradación elegante: si falta Supabase el correo sale igual, si falta
# Resend el lead se guarda igual, si faltan los dos se muestra el error
# que remite a WhatsApp. Ninguna bloquea el build ni el dev server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
CORREO_DESTINO=kevingomez@devbro.xyz
