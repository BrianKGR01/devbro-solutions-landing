---
import Base from '../layouts/Base.astro';
import Barra from '../components/Barra.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Tesis from '../components/Tesis.astro';
import Experiencia from '../components/Experiencia.astro';
import Proceso from '../components/Proceso.astro';
import Paquetes from '../components/Paquetes.astro';
import Postulacion from '../components/Postulacion.astro';
import Limites from '../components/Limites.astro';
// Caso.astro queda construido en el repo pero desconectado de la pagina
// (D24, ver docs/06-decisiones.md): se reactiva cuando haya un caso con
// traccion real. No se importa aca a proposito.
import Preguntas from '../components/Preguntas.astro';
import Contacto from '../components/Contacto.astro';
import Pie from '../components/Pie.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
---

<Base>
  <Barra slot="header" />

  <Hero />
  <Problema />
  <Tesis />
  <Experiencia />
  <Proceso />
  <Paquetes />
  <Postulacion />
  <Limites />
  <Preguntas />
  <Contacto />

  <Fragment slot="footer">
    <Pie />
    <BotonWhatsApp />
  </Fragment>
</Base>
