---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilidades.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DevBro Solutions — Tu idea, funcionando, en tres semanas',
  description = 'Software factory en Santa Cruz de la Sierra. Construimos tu producto en producción en tres a seis semanas, con precio cerrado. El código es tuyo.',
} = Astro.props;

// Astro.site sale de PUBLIC_SITE_URL (astro.config.mjs). Si falta, se omiten
// canonical y og:url en vez de inventar un dominio (docs/06-decisiones.md D3).
const sitio = Astro.site;
const canonical = sitio ? new URL(Astro.url.pathname, sitio).toString() : undefined;
const imagenOg = sitio ? new URL('/og.png', sitio).toString() : '/og.png';

const organizacionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DevBro Solutions',
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Santa Cruz de la Sierra',
    addressCountry: 'BO',
  },
  ...(sitio ? { url: sitio.toString() } : {}),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Las dos fuentes usadas en el hero: sin preload hay salto visible al cargar (docs/04-engineering.md §4) -->
    <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DevBro Solutions" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenOg} />
    {canonical && <meta property="og:url" content={canonical} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenOg} />

    <script type="application/ld+json" set:html={JSON.stringify(organizacionJsonLd)} is:inline />
  </head>
  <body>
    <a class="saltar-al-contenido" href="#contenido">Saltar al contenido</a>
    <slot name="header" />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />

    <script is:inline>
      // Aparicion al hacer scroll (docs/02-design-system.md §7): una sola
      // vez por elemento, escalonado maximo de 60ms entre hermanos que
      // comparten padre. El escalon se calcula aca (no a mano en cada
      // componente) para que agregar/quitar un item de una lista no
      // rompa el orden de los demas.
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        var elementos = document.querySelectorAll('.revelar');
        if (!elementos.length) return;

        var contadorPorPadre = new Map();
        elementos.forEach(function (el) {
          var padre = el.parentElement;
          var indice = contadorPorPadre.get(padre) || 0;
          contadorPorPadre.set(padre, indice + 1);
          el.style.transitionDelay = indice * 60 + 'ms';
        });

        var observador = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (entrada) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('revelar--visible');
                observador.unobserve(entrada.target);
              }
            });
          },
          { threshold: 0.1 }
        );

        elementos.forEach(function (el) {
          observador.observe(el);
        });
      })();
    </script>
  </body>
</html>

<style>
  .saltar-al-contenido {
    position: absolute;
    top: -100%;
    left: var(--e2);
    z-index: 100;
    padding: var(--e2) var(--e3);
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--mono);
    font-size: var(--t-etiqueta);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: var(--borde-fuerte);
  }

  .saltar-al-contenido:focus-visible {
    top: var(--e2);
    outline: 3px solid var(--laton);
    outline-offset: 3px;
  }

  /* #contenido es destino de ancla (skip link) pero no lleva la clase
     .seccion -- necesita el mismo scroll-margin-top a mano.
     docs/06-decisiones.md D15. */
  main#contenido {
    scroll-margin-top: calc(var(--barra-alto) + var(--e2));
  }
</style>
