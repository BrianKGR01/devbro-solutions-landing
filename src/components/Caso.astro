---
// #caso (docs/03-content.md §08, docs/06-decisiones.md D9 y D20).
// Version anonimizada: sin marco de imagen y sin el bloque "Lo que
// construimos" -- el caso se sostiene con el titular y tres datos. Queda
// un solo {{PENDIENTE}} (el rubro), visible a proposito via .pendiente
// (utilidades.css): no se inventa contenido.
// Las tres filas son un <dl>: son pares etiqueta/valor de una ficha de
// orden, no parrafos sueltos.
---

<section id="caso" class="seccion">
  <div class="contenedor">
    <div class="caso">
      <p class="caso__etiqueta">CASO 001</p>

      <h2 class="caso__titulo">ERP completo, en tres semanas.</h2>

      <dl class="caso__datos">
        <div class="caso__dato">
          <dt class="caso__dato-etiqueta">El problema</dt>
          <dd class="caso__dato-valor pendiente">{'{{PENDIENTE: rubro y qué resolvía}}'}</dd>
        </div>
        <div class="caso__dato">
          <dt class="caso__dato-etiqueta">Tiempo</dt>
          <dd class="caso__dato-valor">3 semanas de construcción</dd>
        </div>
        <div class="caso__dato">
          <dt class="caso__dato-etiqueta">Estado</dt>
          <dd class="caso__dato-valor">en validación con usuarios reales</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .caso__etiqueta {
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--t-etiqueta);
    letter-spacing: 0.12em;
    color: var(--laton);
    margin-bottom: var(--e2);
  }

  .caso__titulo {
    font-family: var(--display);
    font-variation-settings: 'wght' 800, 'wdth' 115;
    font-size: var(--t-display-l);
    letter-spacing: -0.02em;
    line-height: 0.94;
    color: var(--papel);
    max-width: 20ch;
    margin-bottom: var(--e6);
    text-wrap: balance;
  }

  /* Filete superior + filas separadas: se lee como ficha de orden, mismo
     lenguaje que la lista de etapas de Proceso.astro. */
  .caso__datos {
    max-width: 62ch;
    border-top: var(--borde);
  }

  .caso__dato {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e1);
    padding-block: var(--e3);
    border-bottom: var(--borde);
  }

  @media (min-width: 640px) {
    .caso__dato {
      grid-template-columns: 14ch 1fr;
      gap: var(--e3);
      align-items: baseline;
    }
  }

  .caso__dato-etiqueta {
    font-family: var(--mono);
    font-size: var(--t-etiqueta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--laton);
  }

  .caso__dato-valor {
    font-family: var(--cuerpo);
    font-size: var(--t-cuerpo-l);
    line-height: 1.5;
    color: var(--papel);
  }

  /* .pendiente (utilidades.css) pisa el color a --humo; el italico ya
     viene de ahi. Se declara despues para que gane por orden de cascada
     dentro del mismo archivo -- pero como .pendiente vive en un archivo
     global y esta es una clase con alcance de componente, Astro le da
     mayor especificidad al selector con hash. Se fuerza el valor aca. */
  .caso__dato-valor.pendiente {
    color: var(--humo);
    font-style: italic;
  }
</style>
