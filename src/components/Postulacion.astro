---
// #postulacion (docs/03-content.md §06b, D30 docs/06-decisiones.md).
// Camino alternativo para equipos sin equipo tecnico NI presupuesto para
// SONDA: postulan por WhatsApp, no por el formulario de #contacto -- se
// evaluan antes de cobrar nada, y si el proyecto puede ser un buen caso
// de exito, se les ofrece un precio mas bajo. Va justo despues de
// Paquetes, antes de Limites: se lee como una cuarta opcion inmediatamente
// despues de ver los tres precios.
import Cta from './Cta.astro';
import { ENLACE_WHATSAPP_POSTULACION } from '../lib/whatsapp';
---

<section id="postulacion" class="seccion postulacion">
  <div class="contenedor">
    <div class="postulacion__marco revelar">
      <h2 class="postulacion__titulo">Programa de Postulación</h2>
      <p class="postulacion__cuerpo">
        Sabemos que no todos los equipos fundadores llegan con presupuesto. Si te falta el equipo
        técnico y tampoco te alcanza para un diagnóstico pago, postulá tu proyecto. Lo evaluamos
        sin costo y, si vemos que puede ser un caso de éxito, te proponemos un precio bastante más
        bajo para construirlo o <span class="subrayado-laton">negociamos cómo hacerlo realidad.</span>
      </p>
      <Cta href={ENLACE_WHATSAPP_POSTULACION} target="_blank" rel="noopener noreferrer">
        Opciones de postulación
      </Cta>
    </div>
  </div>
</section>

<style>
  /* Fondo elevado con patron de puntos industrial sutil (radial-gradient) */
  .postulacion {
    background-color: var(--tinta-2);
    background-image: radial-gradient(rgba(134, 201, 164, 0.12) 1.5px, transparent 1.5px);
    background-size: 24px 24px;
  }

  .postulacion__marco {
    width: 100%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border: var(--borde-fuerte);
    padding: var(--e5) var(--e3);
    background-color: rgba(15, 21, 18, 0.85);
  }

  @media (min-width: 640px) {
    .postulacion__marco {
      padding: var(--e6) var(--e5);
    }
  }

  .postulacion__titulo {
    font-family: var(--display);
    font-variation-settings: 'wght' 800, 'wdth' 115;
    font-size: var(--t-display-l);
    letter-spacing: -0.02em;
    line-height: 0.94;
    color: var(--papel);
    margin-bottom: var(--e5);
    text-wrap: balance;
    position: relative;
    display: inline-block;
    padding-bottom: var(--e2);
  }

  .postulacion__titulo::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 4px;
    background: var(--verde);
    box-shadow: 0 2px 0 var(--verde-luz);
  }

  .postulacion__cuerpo {
    font-family: var(--cuerpo);
    font-size: var(--t-cuerpo-l);
    line-height: 1.65;
    color: var(--humo);
    max-width: 68ch;
    margin-inline: auto;
    margin-bottom: var(--e5);
    text-align: center;
  }

  /* Responsive para el CTA en pantallas chicas */
  .postulacion__marco :global(.cta) {
    width: auto;
    max-width: 100%;
    font-size: clamp(0.8125rem, 3.5vw, 0.95rem);
    white-space: normal;
  }

  @media (max-width: 480px) {
    .postulacion__marco :global(.cta) {
      width: 100%;
      padding: 16px 20px;
    }
  }
</style>
