---
// #problema (docs/01-brief.md: "3 ítems con numeral en latón", docs/03-content.md §02).
// Patrón "Tarjeta / ítem de orden" (docs/02-design-system.md §5, .ficha/.ficha__num)
// replicado acá con nombres en español porque todavía no existe un componente
// Ficha.astro reutilizable.
const items = [
  {
    numero: 'ÍTEM 01',
    titulo: 'Nadie te sabe decir cuánto',
    descripcion:
      'Pedís tres cotizaciones por lo mismo y te dan seis mil, veinticinco mil y sesenta mil dólares. Ninguno te explica por qué.',
  },
  {
    numero: 'ÍTEM 02',
    titulo: 'Los plazos se estiran solos',
    descripcion: 'Te dijeron tres meses. Vas por el séptimo. Todavía no lo vio un usuario real.',
  },
  {
    numero: 'ÍTEM 03',
    titulo: 'Te quedás amarrado',
    descripcion:
      'El sistema funciona, pero solo ellos lo entienden. No podés cambiar de equipo aunque quieras.',
  },
];
---

<section id="problema" class="seccion">
  <div class="contenedor">
    <h2 class="problema__titulo revelar">
      <span class="problema__titulo-oracion">Tenés el problema.</span>
      <span class="problema__titulo-oracion">Tenés la plata.</span>
      <span class="problema__titulo-oracion">No tenés cómo saber si te están vendiendo humo.</span>
    </h2>

    <ul class="problema__lista grilla-3">
      {
        items.map((item) => (
          <li class="problema__ficha revelar">
            <p class="problema__numero">{item.numero}</p>
            <h3 class="problema__ficha-titulo">{item.titulo}</h3>
            <p class="problema__ficha-descripcion">{item.descripcion}</p>
          </li>
        ))
      }
    </ul>

    <p class="problema__microcopia revelar">NINGUNO DE ESTOS TRES ES CULPA TUYA</p>
  </div>
</section>

<style>
  .problema__titulo {
    font-family: var(--display);
    font-variation-settings: 'wght' 800, 'wdth' 115;
    font-size: var(--t-display-l);
    letter-spacing: -0.02em;
    line-height: 0.94;
    color: var(--papel);
    margin-bottom: var(--e6);
    /* Regla base para --t-display-l (docs/02-design-system.md §3): evita
       cortes que separan una oracion corta de la siguiente palabra suelta.
       Se hereda a cada span de abajo -- sigue sirviendo para balancear el
       envoltorio interno de la tercera oracion en movil. */
    text-wrap: balance;
  }

  /* Cada oracion arranca en su propia linea (display:block), pero puede
     envolver internamente si no entra -- por eso NO son <br> ni <p>
     separados, que impedirian el balance interno de la oracion larga.
     Sin max-width en el h2: el ancho real del contenedor ya decide donde
     envuelve cada una, sin una columna artificial mas angosta. Sin margen
     entre spans -- el line-height 0.94 ya da el espaciado apretado que
     pide el resto de los titulares. */
  .problema__titulo-oracion {
    display: block;
  }

  .problema__ficha {
    background: var(--tinta-3);
    border: var(--borde);
    padding: var(--e4);
  }

  .problema__numero {
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--t-etiqueta);
    letter-spacing: 0.12em;
    color: var(--laton);
    margin-bottom: var(--e2);
  }

  .problema__ficha-titulo {
    font-family: var(--display);
    font-variation-settings: 'wght' 800, 'wdth' 112;
    font-size: var(--t-titulo);
    line-height: 1.1;
    color: var(--papel);
    margin-bottom: var(--e2);
  }

  .problema__ficha-descripcion {
    font-family: var(--cuerpo);
    font-size: var(--t-cuerpo);
    line-height: 1.65;
    color: var(--humo);
  }

  /* Mismo tratamiento que la microcopia del hero (docs/03-content.md §01):
     mono, --t-etiqueta, --humo. */
  .problema__microcopia {
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--t-etiqueta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--humo);
    margin-top: var(--e5);
  }
</style>
