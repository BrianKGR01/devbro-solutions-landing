---
// #hero-postulacion (Hero de la página /postulaciones).
// Presenta el servicio de CTO Fraccional y Co-Inversión Tecnológica para startups.
import Cta from '../Cta.astro';
---

<section id="inicio-postulacion" class="hero-postulacion seccion">
  <div class="contenedor">
    <div class="hero-postulacion__cuerpo revelar">
      <p class="hero-postulacion__antetitulo">CTO FRACCIONAL Y CO-INVERSIÓN TECNOLÓGICA</p>

      <h1 class="hero-postulacion__titulo">
        No busques solo un programador.<br />Buscá un socio técnico.
      </h1>

      <div class="hero-postulacion__contenido">
        <p class="hero-postulacion__parrafo">
          Tenés la validación, el mercado y el empuje. Te falta quien dirija la tecnología.
          Nosotros asumimos el rol de CTO para que tu equipo se enfoque en el negocio. Nuestro fin
          no es invadir tu startup ni tomar el control; venimos a guiarte y a hacernos cargo de que
          tu tecnología no falle. Somos parte de tu startup, si así lo decidís.
        </p>

        <div class="hero-postulacion__botones">
          <Cta href="#formulario-postulacion">Postular mi startup</Cta>
          <Cta href="#modelos" variante="secundario">Modelos de asociación</Cta>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-postulacion {
    min-height: calc(100vh - var(--barra-alto));
    display: flex;
    align-items: center;
    padding-block: var(--e6);
  }

  @media (max-width: 639px) {
    .hero-postulacion {
      min-height: auto;
      padding-top: var(--e4);
    }
  }

  .hero-postulacion__cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--e4);
    max-width: 72ch;
    width: 100%;
  }

  .hero-postulacion__antetitulo {
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--t-etiqueta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--humo);
    max-width: none;
  }

  .hero-postulacion__titulo {
    font-family: var(--display);
    font-variation-settings: 'wght' 900, 'wdth' 118;
    font-size: clamp(2rem, 5vw, 4.5rem);
    line-height: 1;
    color: var(--papel);
    max-width: 18ch;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .hero-postulacion__contenido {
    display: flex;
    flex-direction: column;
    gap: var(--e4);
  }

  .hero-postulacion__parrafo {
    font-family: var(--cuerpo);
    font-size: var(--t-cuerpo-l);
    line-height: 1.65;
    color: var(--papel);
    max-width: 62ch;
  }

  .hero-postulacion__botones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e2);
  }

  @media (min-width: 1024px) and (max-height: 820px) {
    .hero-postulacion {
      padding-block: var(--e4);
    }
    .hero-postulacion__cuerpo {
      gap: var(--e2);
    }
    .hero-postulacion__contenido {
      gap: var(--e2);
    }
  }
</style>
